rules_version = '2';

// Wklej to w Firebase Console → Firestore Database → zakładka "Rules" → Publish.
//
// To jest klub amatorski bez logowania graczy (zaufanie w drużynie), więc każdy
// może odczytać i zapisać zapisy/adresy. Zablokowane jest za to tworzenie
// jakichkolwiek innych kolekcji oraz kasowanie dokumentów — żeby przez pomyłkę
// (lub czyjś eksperyment) nikt nie wyczyścił bazy.

service cloud.firestore {
  match /databases/{database}/documents {

    match /signups/{eventId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if false;
    }

    match /events/{eventId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if false;
    }

    // Jednorazowy przydział 90 punktów na karcie zawodnika (dokument = slug
    // gracza). Celowo "allow update: if false" — to jest właściwa blokada
    // "raz na zawsze": pierwszy zapis (create) przechodzi, każda kolejna
    // próba nadpisania tego samego dokumentu jest odrzucana przez samą bazę,
    // niezależnie od tego, co robi kod w przeglądarce.
    match /playerCardStats/{slug} {
      allow read: if true;
      allow create: if true;
      allow update: if false;
      allow delete: if false;
    }

    // Wspólna plansza taktyki (jeden dokument "current") — każdy widzi to
    // samo i każdy może przestawiać zawodników (tak jak adres treningu).
    match /tactic/{docId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if false;
    }

    // Wiadomości od trenera/kierownika do wszystkich (ogłoszenia). Kto może
    // wysyłać, pilnuje strona (panel trenera/kierownika, hasło) — tu, tak jak
    // w reszcie kolekcji, nie ma logowania Firebase, więc reguły same nie
    // odróżnią ról. Za to nikt nic nie może nadpisać ani skasować — kanał
    // rośnie tylko przez dopisywanie nowych wiadomości.
    match /messages/{msgId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if false;
    }

    // Licznik wizyt per gracz (dokument = slug gracza), rosnący przy każdym
    // otwarciu apki. W UI widoczny tylko dla Krzysztofa Obremskiego, ale —
    // tak jak reszta kolekcji, bez prawdziwego logowania Firebase — same
    // reguły nie potrafią tego odróżnić po stronie serwera.
    match /visits/{slug} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
